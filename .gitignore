# Ignorar todos los archivos y carpetas ocultos
.*

# Excepciones de archivos ocultos que SÍ quieres en Git
!.gitignore
!.github/

# Archivos generados por Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
sdist/
wheel/

# Entornos virtuales (ya cubiertos en parte por .*, pero bueno mantenerlos)
venv/
env/

# Archivos de desarrollo y temporales
*.log
*.tmp
*.swp
*.bak

# Si tienes archivos de configuración sensibles, ¡AÑÁDELOS AQUÍ!
# ejemplo: config.ini
# ejemplo: secretos
config/perfil*
auth*.json
